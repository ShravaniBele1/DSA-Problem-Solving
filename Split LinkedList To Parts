class Solution {
    public ListNode[] splitListToParts(ListNode head, int k) {
        
        //step 1: find the total number of nodes
        int length = 0;
        ListNode current = head;

        while(current != null){
            length++ ;
            current = current.next;
        }

        //step 2: find minimum nodes in each part
        int partSize = length / k ;

        //step 3: find how many extra nodes are left
        int extra = length % k ;

        //step 4: create array to store k parts
        ListNode[] result = new ListNode[k];

        //step 5: start from begining
        current = head ;

        for(int i =0 ;i < k ;i++){

            //first extra parts get one additional node
            int currentPartSize = partSize;

            if(i < extra){
                currentPartSize++ ;
            }

            //store starting part of this part
            result[i] = current;

            //move to the end of of this part
            for(int j = 1 ;j < currentPartSize ;j++){
                current = current.next;
            }

            //break the connection
            if(current != null){
                ListNode nextPart = current.next ;
                current.next = null ;
                current = nextPart;
            }

        }

        return result;
    }
}
