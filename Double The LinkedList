class Solution {
    public ListNode doubleIt(ListNode head) {
        
        head = reverse(head);

        int carry = 0;
        ListNode current = head;

        while(current != null){

            int value = current.val * 2 + carry;

            current.val = value % 10 ;
            carry = value / 10 ;

            current = current.next ;
        }

        head = reverse(head);
        
        if(carry > 0){
            ListNode newNode = new ListNode(carry);
            newNode.next = head;
            head = newNode;
        }

        return head;
    }

    private ListNode reverse(ListNode head){
        ListNode prev = null;
        ListNode curr = head;

        while(curr != null){
            ListNode next = curr.next;

            curr.next = prev;
            prev = curr;
            curr = next;
        }

        return prev;
    }
}
