class Solution {
    public List<String> binaryTreePaths(TreeNode root) {
        
        List<String> list = new ArrayList<>();

        if(root == null){
            return list;
        }

        findPaths(root , "", list);

        return list; 
    }

    public void findPaths(TreeNode root, String path, List<String> list){

        path = path + root.val;

        //leaf node
        if(root.left == null && root.right == null) {
            list.add(path);
            return;
        }

        if(root.left != null){
            findPaths(root.left ,path + "->", list);
        }

        if(root.right != null){
            findPaths(root.right , path + "->", list);
        }

    }
}
