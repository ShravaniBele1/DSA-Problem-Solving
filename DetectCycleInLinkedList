public class Solution {
    public ListNode detectCycle(ListNode head) {
        
        ListNode slow = head ;
        ListNode fast = head ;

        //step-1 find whether cycle exists
        while(fast != null && fast.next != null){

            slow = slow.next;
            fast = fast.next.next;

            //ste-2 find starting point of cycle
            if(slow == fast){

                ListNode slow2 = head;

                while(slow2 != slow){
                    slow2 = slow2.next;
                    slow = slow.next;
                }

                return slow2;
            }
        } 
     return null ;  
    }  
}
